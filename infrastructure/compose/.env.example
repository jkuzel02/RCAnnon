# Non-secret example environment configuration for RCAnnon Docker Compose.
# Copy to .env (or pass via --env-file) when overriding defaults.

# Container image (defaults to local build; set to ghcr.io/jkuzel02/rcannon:0.1.0 or :main to pull from GHCR)
RCANNON_IMAGE=rcannon-api:local

# Loopback UI port exposed on 127.0.0.1 only
RCANNON_UI_PORT=3080

# Provider mode: "mock" for clean-checkout smoke tests, "einfra" with compose.einfra.yaml
RCANNON_PROVIDER_MODE=mock

# JSON map of allowlisted target cluster aliases to allowed Kubernetes namespaces
RCANNON_ALLOWED_SCOPES={"lab":["demo"]}

# Live e-INFRA CZ endpoint and model (used with compose.einfra.yaml)
LLM_AI_EINFRA_BASE_URL=https://llm.ai.e-infra.cz/v1
LLM_AI_EINFRA_MODEL=deepseek-v4.1-flash

# Optional target kubeconfig mount settings (used with compose.kube.yaml)
RCANNON_KUBECONFIG_DIR=./infrastructure/compose/kubeconfig
RCANNON_KUBECONFIG_FILE=config
RCANNON_KUBE_CONTEXT=kind-local
RCANNON_TARGET_ALIAS=lab
