# Non-secret example environment configuration for RCAnnon Docker Compose.
# Copy to .env (or pass via --env-file) when overriding defaults.

# Container image (defaults to local build; set to ghcr.io/jkuzel02/rcannon:0.1.7 or :latest to pull from GHCR) # x-release-please-version
RCANNON_IMAGE=rcannon-api:local

# Loopback UI port exposed on 127.0.0.1 only
RCANNON_UI_PORT=3080

# Non-secret administrator identity seeded on a fresh MongoDB via --profile bootstrap
LIBRECHAT_ADMIN_EMAIL=admin@rcannon.local
LIBRECHAT_ADMIN_NAME=RCAnnon Admin
LIBRECHAT_ADMIN_USERNAME=rcannon-admin

# Provider mode: "auto" uses openai when OPENAI_API_KEY is set or mock otherwise
RCANNON_PROVIDER_MODE=auto

# JSON map of allowlisted target cluster aliases to allowed Kubernetes namespaces
RCANNON_ALLOWED_SCOPES={"lab":["demo"]}

# Live OpenAI-compatible API endpoint and model (used with compose.openai.yaml)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional target kubeconfig mount settings (used with compose.kube.yaml)
RCANNON_KUBECONFIG_DIR=./infrastructure/compose/kubeconfig
RCANNON_KUBECONFIG_FILE=config
RCANNON_KUBE_CONTEXT=kind-local
RCANNON_TARGET_ALIAS=lab
