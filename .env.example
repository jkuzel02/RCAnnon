# Paste your OpenAI (or OpenAI-compatible) API key.
# Leave empty to run RCAnnon in offline mock mode.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Local LibreChat UI login (bound to 127.0.0.1:3080 only; change before exposing remotely)
LIBRECHAT_ADMIN_EMAIL=admin@rcannon.local
LIBRECHAT_ADMIN_PASSWORD=rcannon-local-admin

# Optional: pull a prebuilt GHCR image instead of building locally
# RCANNON_IMAGE=ghcr.io/jkuzel02/rcannon:latest
